# Database (Neon PostgreSQL — use asyncpg driver prefix)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# Secrets
ENCRYPTION_KEY=             # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXTAUTH_SECRET=            # must match frontend NEXTAUTH_SECRET; generate with: openssl rand -base64 32
SYNC_SECRET=                # random secret for the /sync/cron endpoint; generate with: openssl rand -base64 24

# CORS — set to your frontend URL
FRONTEND_URL=http://localhost:3000

# Brokerage OAuth (only needed if connecting Longbridge accounts)
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_CALLBACK_URL=http://localhost:8000/brokerages/longbridge/oauth/callback
